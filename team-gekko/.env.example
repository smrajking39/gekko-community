# =====================================================================
# Team Gekko — environment variables (template)
# Copy to .env.local for local dev. Fill in only what you need.
# Phase 0 is mock-only: you can leave everything blank and `npm run dev`
# will still work. Wire services up as you reach each phase.
# =====================================================================

# --- App
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Team Gekko"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Feature flags (Phase 0)
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_FEATURE_3D=true
NEXT_PUBLIC_FEATURE_MESSAGES=false

# --- Database (Neon) — Phase 0: optional
DATABASE_URL=

# --- Auth.js — Phase 2
# Generate AUTH_SECRET with: `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Set these to "1" once the matching provider env vars are filled so the
# login form renders the "Continue with X" buttons. Leave blank to hide them.
NEXT_PUBLIC_OAUTH_DISCORD=
NEXT_PUBLIC_OAUTH_GITHUB=

# Short-lived signed tokens (email verify, password reset).
# Generate JWT_VERIFY_SECRET with: `openssl rand -base64 32`
JWT_VERIFY_SECRET=

# Password hashing uses bcryptjs (pure JS, edge-compatible). No tuning needed.
# Legacy argon2 tuning
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# --- Seed
OWNER_EMAIL=owner@teamgekko.local
OWNER_PASSWORD=changeme-rotate-immediately

# --- Cloudinary — Phase 4
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=gekko_signed

# --- Email (Resend) — Phase 2+
RESEND_API_KEY=
EMAIL_FROM="Team Gekko <no-reply@teamgekko.local>"

# --- Realtime (Pusher) — Phase 7
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# --- Cache / KV (Upstash Redis) — Phase 1+
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Deferred jobs (Upstash QStash) — Phase 5+
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Cron auth (Vercel Cron) — Phase 5+
CRON_SECRET=

# --- Web Push (VAPID) — Phase 6
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT=mailto:admin@teamgekko.local

# --- Discord (extras beyond OAuth)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_ANNOUNCEMENTS=
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/EPZ4EhAPJh

# --- Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# --- Rate limits (requests/minute)
RATE_LIMIT_GLOBAL=120
RATE_LIMIT_AUTH=10
